UnlitGeneric
{
	$baseTexture "xyz/effects/infinitygauntlet/web"
	$additive 1
	$basetexturetransform "center .2 .6 scale 100 100 rotate 0 translate 0 0"
	$model 1
	$translucent 1
	$vertexcolor 1
	$vertexalpha 1
	$ignorez 1
	$texscale 6
	
	Proxies
	{
		TextureTransform
		{
			scaleVar	$texscale
			resultVar	$basetexturetransform
		}

		AnimatedTexture
		{
			animatedtexturevar $baseTexture	
			animatedtextureframenumvar $frame
			animatedtextureframerate 25.00
		}
		
		sine
		{
			sineperiod .5
			resultvar $alpha
			sinemin	1
			sinemax 1
		}
	}
}
